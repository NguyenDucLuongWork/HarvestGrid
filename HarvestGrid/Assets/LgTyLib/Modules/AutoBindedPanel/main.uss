/* ==========================================================================
   MAIN SHARED USS - Core Design Tokens & Base Components
   Converted from HTMLRef/css/main.css for Unity UI Toolkit
   ========================================================================== */
:root {
    /* Color Palette (Deep Slate / Gold Glass) */
    --bg-deep: rgb(11, 15, 23);
    --bg-panel: rgba(18, 25, 38, 0.90);
    --bg-panel-hover: rgba(26, 36, 54, 0.95);
    --bg-panel-active: rgba(36, 50, 75, 0.98);
    --bg-subpanel: rgba(26, 35, 52, 0.85);

    --border-panel: rgba(255, 255, 255, 0.12);
    --border-subpanel: rgba(255, 255, 255, 0.08);
    --border-highlight: rgba(255, 255, 255, 0.22);

    /* Accent Colors */
    --color-gold: rgb(250, 204, 21);
    --color-gold-muted: rgb(202, 138, 4);
    --color-gold-glow: rgba(250, 204, 21, 0.35);
    --color-green: rgb(74, 222, 128);
    --color-rose: rgb(248, 113, 113);
    --color-gem: rgb(103, 232, 249);
    --color-sky: rgb(96, 165, 250);

    /* Text Colors */
    --text-main: rgb(248, 250, 252);
    --text-muted: rgb(148, 163, 184);
    --text-dim: rgb(100, 116, 139);
}

/* Base Glassmorphism Panel */
.hud-panel {
    background-color: rgba(18, 25, 38, 0.90);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 28px;
}

/* Subpanel */
.hud-subpanel {
    background-color: rgba(26, 35, 52, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 20px;
}

/* Base Button */
.hud-btn {
    background-color: transparent;
    border-width: 0;
    color: rgb(248, 250, 252);
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.hud-btn:hover {
    color: rgb(250, 204, 21);
}

/* Base Vector Icon Wrapper */
.icon {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
