/* =========================================================================
   Home Screen & Play Button Styles matching Farm Game UI.html (#play, #hint, #top-r)
   ========================================================================= */

.home-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: center;
}

.top-r {
    position: absolute;
    right: 30px;
    top: 80px;
    flex-direction: row;
}

.sm {
    height: 90px;
    padding-left: 36px;
    padding-right: 36px;
    border-radius: 24px;
    border-width: 6px;
    border-color: #7a4a24;
    background-color: #c98a4b;
    color: #ffffff;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 18px;
}

.sm:hover {
    opacity: 0.9;
}

.sm:active {
    translate: 0 6px;
}

.hint {
    position: absolute;
    top: 1000px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 48px;
    color: #ffffff;
    -unity-font-style: bold;
    opacity: 0.95;
}

.btn-play {
    position: absolute;
    bottom: 400px;
    width: 560px;
    height: 200px;
    border-radius: 44px;
    border-width: 8px;
    border-color: #b86a00;
    background-color: #ffb800;
    color: #ffffff;
    font-size: 100px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.btn-play:hover {
    background-color: #ffc425;
}

.btn-play:active {
    translate: 0 10px;
    background-color: #e5a400;
}
