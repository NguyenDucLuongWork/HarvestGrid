.user-gold {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 90px;
    padding-left: 30px;
    padding-right: 30px;
    border-radius: 24px;
    border-width: 6px;
    border-color: #7a4a24;
    background-color: #c98a4b;
}

.gold-label {
    color: #ffe49a;
    font-size: 38px;
    -unity-font-style: bold;
    margin-right: 16px;
}

.gold-value {
    color: #ffffff;
    font-size: 44px;
    -unity-font-style: bold;
}