<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/!_HarvestGrid/UI/UIGenerating/HomePanel/UIHomePanel.uss?fileID=7433441132597879392&amp;guid=e5f6708192a3b4c5d6e7f8091a2b3c4d&amp;type=3#UIHomePanel"/>
    <ui:VisualElement name="root" picking-mode="Ignore" class="home-container" style="width: 100%; height: 100%; min-width: 100%; min-height: 100%;">
        <ui:Button name="btn-play" text="PLAY" class="btn-play" style="bottom: 350px; height: 117px; left: auto; position: absolute; width: 277px;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="playButtonText" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Button>
        <ui:VisualElement name="top-r" class="top-r" style="right: 2px; width: 400px; max-width: 400px; position: absolute; top: 20px;">
            <ui:VisualElement name="user-gold" class="user-gold">
                <ui:Label text="COIN: " name="Label" class="gold-label"/>
                <ui:Label name="gold-value" text="0" class="gold-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="userGold" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
