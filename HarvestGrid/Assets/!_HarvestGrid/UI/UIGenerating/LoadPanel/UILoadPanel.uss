/* =========================================================================
   Styles for Load / Levels Panel matching Farm Game UI.html (#p-load)
   ========================================================================= */

.panel {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 230px;
    bottom: 360px;
    background-color: #fff3d1;
    border-width: 10px;
    border-color: #7a4a24;
    border-radius: 50px;
    flex-direction: column;
    overflow: hidden;
}

.ph {
    height: 150px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: #c98a4b;
    border-bottom-width: 8px;
    border-bottom-color: #7a4a24;
}

.ph-title {
    color: #ffffff;
    font-size: 76px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pb {
    flex-grow: 1;
    padding: 36px;
}

/* =========================================================================
   Level Item Card (.lv)
   ========================================================================= */

.lv {
    background-color: #ffffff;
    border-width: 6px;
    border-color: #e0c58a;
    border-radius: 36px;
    padding: 28px;
    margin-bottom: 26px;
}

.lv.lock {
    opacity: 0.55;
}

.lv-h {
    flex-direction: row;
    align-items: center;
}

.num {
    width: 110px;
    height: 110px;
    border-radius: 55px;
    background-color: #7bc043;
    border-width: 6px;
    border-color: #4d8a20;
    color: #ffffff;
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 24px;
}

.lv.lock .num {
    background-color: #aaaaaa;
    border-color: #777777;
}

.lv-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: #3b2410;
    flex-grow: 1;
}

.badge {
    font-size: 36px;
    -unity-font-style: bold;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 30px;
    background-color: #dddddd;
    color: #3b2410;
}

.badge.done {
    background-color: #4caf50;
    color: #ffffff;
}

.badge.go {
    background-color: #ffc61a;
    color: #3b2410;
}

/* Requirements (.req) */
.req {
    margin-top: 20px;
    margin-bottom: 10px;
    flex-direction: column;
}

.req-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.req-desc {
    font-size: 42px;
    color: #3b2410;
}

.t {
    font-size: 42px;
    color: #8a6a40;
    -unity-font-style: bold;
}

/* Meta: time & buttons */
.meta {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
}

.meta .time {
    flex-grow: 1;
    font-size: 40px;
    color: #3b2410;
}

.btn {
    height: 90px;
    padding-left: 40px;
    padding-right: 40px;
    border-radius: 24px;
    border-width: 6px;
    border-color: #4d8a20;
    background-color: #7bc043;
    color: #ffffff;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 14px;
}

.btn.alt {
    background-color: #c98a4b;
    border-color: #7a4a24;
}

.btn:disabled {
    background-color: #bbbbbb;
    border-color: #888888;
    color: #666666;
}

.btn:hover {
    opacity: 0.9;
}

.btn:active {
    translate: 0 4px;
}

/* Rank / Leaderboard */
.rank {
    margin-top: 24px;
    border-top-width: 4px;
    border-top-color: #e0c58a;
    padding-top: 16px;
    display: none;
}

.rank.show {
    display: flex;
}

.rk {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 42px;
    color: #3b2410;
}

.rk .p {
    width: 70px;
    font-size: 48px;
}

.rk .nm {
    flex-grow: 1;
    font-size: 42px;
}

.rk.me {
    background-color: #fff3b0;
    border-radius: 16px;
    padding-left: 16px;
    padding-right: 16px;
}
