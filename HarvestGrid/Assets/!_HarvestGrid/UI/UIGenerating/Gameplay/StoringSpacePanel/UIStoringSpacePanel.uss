.inv-container {
    width: 100%;
    background-color: #c98a3b;
    border-width: 10px;
    border-color: #8a5a22;
    border-radius: 40px;
    padding: 20px;
    align-items: center;
    justify-content: center;
}

.board {
    position: relative;
    background-color: #c58f8f;
    border-radius: 26px;
    padding: 16px;
    align-items: center;
    justify-content: center;
    align-self: center;
}

.board-content {
    position: relative;
    align-self: center;
    padding: 0;
    margin: 0;
}

.cells-grid {
    position: relative;
    flex-direction: column;
    padding: 0;
    margin: 0;
}

.cell-row {
    flex-direction: row;
    padding: 0;
    margin: 0;
}

.cell {
    background-color: #f3e3b8;
    border-radius: 12px;
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    transition: background-color 0.1s ease-out;
}

.cell.empty {
    background-color: #f3e3b8;
}

.cell.occupied {
    background-color: #e5d4a4;
}

.cell.lock {
    background-color: #a89478;
    border-width: 3px;
    border-color: #7d6850;
    opacity: 0.88;
}

.cell-lock-icon {
    font-size: 38px;
    -unity-text-align: middle-center;
    color: #4a3828;
    opacity: 0.65;
    margin: 0;
    padding: 0;
    pointer-events: none;
}

/* Snapping preview highlights on board cells */
.cell.snap-preview {
    background-color: #8be05a;
    border-width: 4px;
    border-color: #3a8a22;
}

.cell.snap-invalid {
    background-color: #ff7a6b;
    border-width: 4px;
    border-color: #d32f2f;
}

.items-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    padding: 0;
    margin: 0;
}

.placed-item {
    position: absolute;
    pointer-events: auto;
    padding: 0;
    margin: 0;
    transition: opacity 0.12s ease-out, scale 0.12s ease-out;
}

.placed-item.item-drag {
    opacity: 0.88;
    scale: 1.04;
    transition: none;
}

/* Valid placement footprint styling */
.placed-item.item-ok .fp-cell-on {
    background-color: #8be05a;
    border-color: #3a8a22;
}

/* Invalid placement footprint styling */
.placed-item.item-bad .fp-cell-on {
    background-color: #ff7a6b;
    border-color: #d32f2f;
}
