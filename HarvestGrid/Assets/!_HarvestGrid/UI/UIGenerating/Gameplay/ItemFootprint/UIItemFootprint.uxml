<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="UIItemFootprint.uss" />
    <ui:VisualElement name="item-footprint-root" class="item-fp-root">
        <!-- Background Footprint Grid of Cells -->
        <ui:VisualElement name="fp-grid" class="fp-grid">
            <!-- Dynamically populated cells -->
            <ui:VisualElement class="fp-row">
                <ui:VisualElement class="fp-cell fp-cell-on" />
                <ui:VisualElement class="fp-cell fp-cell-on" />
            </ui:VisualElement>
            <ui:VisualElement class="fp-row">
                <ui:VisualElement class="fp-cell fp-cell-on" />
                <ui:VisualElement class="fp-cell fp-cell-off" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Overlay Item Visual / Icon -->
        <ui:VisualElement name="fp-icon-wrap" class="fp-icon-wrap">
            <ui:Label name="lbl-fp-icon" text="🌾" class="fp-icon-text">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="icon" binding-mode="ToTarget" />
                </Bindings>
            </ui:Label>
            <ui:Image name="img-fp-icon" class="fp-icon-image" scale-mode="ScaleToFit">
                <Bindings>
                    <ui:DataBinding property="sprite" data-source-path="iconSprite" binding-mode="ToTarget" />
                </Bindings>
            </ui:Image>
        </ui:VisualElement>

        <!-- Cooldown Progress Overlay on footprint cells -->
        <ui:VisualElement name="fp-cd-wrap" class="fp-cd-wrap">
            <ui:VisualElement name="fp-cd-fill" class="fp-cd-fill" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
