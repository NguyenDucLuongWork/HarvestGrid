.item-fp-root {
    position: relative;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 16px;
    padding: 0;
    margin: 0;
    width: 100%;
    height: 100%;
}

.fp-grid {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

.fp-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

.fp-cell {
    border-radius: 12px;
    padding: 0;
    margin: 0;
}

.fp-cell-on {
    background-color: #e9b11c;
    border-width: 4px;
    border-color: #b98400;
}

.fp-cell-off {
    background-color: transparent;
    border-width: 0;
}

.fp-icon-wrap {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.fp-icon-text {
    font-size: 84px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.fp-icon-image {
    width: 80%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.fp-cd-wrap {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: 12px;
}

.fp-cd-fill {
    width: 100%;
    height: 0%;
    background-color: rgba(0, 0, 0, 0.4);
    transform-origin: top;
}
