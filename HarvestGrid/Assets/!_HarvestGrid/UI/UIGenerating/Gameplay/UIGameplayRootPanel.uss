.gameplay-app {
    width: 100%;
    height: 100%;
    background-color: #5da05c;
    align-items: center;
    justify-content: flex-start;
}

.gameplay-scroll {
    width: 100%;
    height: 100%;
    max-width: 1060px;
    padding-top: 70px;
    padding-bottom: 40px;
    padding-left: 20px;
    padding-right: 20px;
    align-items: center;
}

.panel-slot {
    width: 100%;
    margin-bottom: 22px;
    align-items: center;
    justify-content: center;
}
