.header-container {
    width: 100%;
    padding: 10px 16px;
    flex-direction: column;
    gap: 18px;
}

.header-row {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    width: 100%;
}

/* Level circle */
.lvl-badge {
    width: 110px;
    height: 110px;
    border-radius: 55px;
    background-color: #4ea3e6;
    border-width: 6px;
    border-color: #ffffff;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.lvl-text {
    color: #ffffff;
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* XP / Countdown Bar */
.xp-bar {
    flex-grow: 1;
    height: 60px;
    background-color: #4a7c8a;
    border-radius: 30px;
    overflow: hidden;
    position: relative;
    justify-content: center;
}

.xp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: #38a6e8;
    border-radius: 30px;
}

.xp-text {
    color: #ffffff;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 100%;
}

/* Pill Base */
.pill {
    background-color: #fff8e7;
    border-width: 5px;
    border-color: #d4a359;
    border-radius: 30px;
    padding: 0 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.gem-pill {
    height: 80px;
    flex-shrink: 0;
}

.pill-text {
    font-size: 38px;
    -unity-font-style: bold;
    color: #4a2f17;
}

.pill-icon {
    font-size: 36px;
}

/* Bar 2: Shop, Cash, Chips */
.bar2 {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.65);
    border-radius: 32px;
    padding: 12px;
    gap: 14px;
    width: 100%;
}

.shop-btn {
    width: 110px;
    height: 104px;
    border-radius: 24px;
    background-color: #f0a23a;
    border-width: 5px;
    border-color: #8d5727;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

.shop-btn-icon {
    font-size: 54px;
}

.cash-pill {
    height: 104px;
    min-width: 150px;
    padding: 0 16px;
    flex-direction: column;
    justify-content: center;
    gap: 0;
    margin: 0;
    border-color: #8d5727;
}

.cash-icon {
    font-size: 36px;
    -unity-text-align: middle-center;
}

.cash-text {
    font-size: 38px;
    -unity-font-style: bold;
    color: #4a2f17;
    -unity-text-align: middle-center;
}

/* Crop Chips Scroll */
.chips-scroll {
    flex-grow: 1;
    overflow: hidden;
    height: 120px;
}

.chips-container {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    padding-left: 4px;
    padding-right: 8px;
}

/* Individual Crop Chip */
.crop-chip {
    min-width: 240px;
    height: 104px;
    position: relative;
    background-color: #fff8e7;
    border-width: 5px;
    border-color: #eadbb2;
    border-radius: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 28px;
    gap: 10px;
}

.crop-chip.done {
    border-color: #5cc13a;
    border-width: 5px;
}

.ci-wrap {
    position: relative;
    width: 76px;
    height: 76px;
    align-items: center;
    justify-content: center;
}

.crop-icon-text {
    font-size: 50px;
    -unity-text-align: middle-center;
}

.crop-icon-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.crop-stock-badge {
    position: absolute;
    left: -4px;
    bottom: -4px;
    min-width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: #ffffff;
    border-width: 3px;
    border-color: #12b5a6;
    color: #12b5a6;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0 4px;
}

.crop-tier {
    position: absolute;
    top: -18px;
    right: 18px;
    font-size: 32px;
    -unity-font-style: bold;
    color: #f2b705;
}

.crop-count {
    flex-grow: 1;
    font-size: 38px;
    -unity-font-style: bold;
    color: #4a2f17;
    -unity-text-align: middle-center;
}

.crop-price-badge {
    position: absolute;
    left: 54px;
    bottom: -18px;
    background-color: #ffe9a8;
    border-width: 3px;
    border-color: #c98a3b;
    border-radius: 14px;
    padding: 2px 12px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #4a2f17;
}
