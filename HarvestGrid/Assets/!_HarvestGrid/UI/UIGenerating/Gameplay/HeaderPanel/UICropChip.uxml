<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="crop-chip-root" class="crop-chip">
        <!-- Crop Icon & Growing Stock Badge -->
        <ui:VisualElement class="ci-wrap">
            <ui:Label name="lbl-icon" text="🥒" class="crop-icon-text" />
            <ui:VisualElement name="img-icon" class="crop-icon-image" style="display: none;" />
            <ui:Label name="lbl-stock" text="2" class="crop-stock-badge" />
        </ui:VisualElement>

        <!-- Star / Tier Label -->
        <ui:Label name="lbl-tier" text="1★" class="crop-tier" />

        <!-- Count / Target -->
        <ui:Label name="lbl-count" text="0/5" class="crop-count" />

        <!-- Price Badge (At Bottom) -->
        <ui:Label name="lbl-price" text="🪙 12" class="crop-price-badge" />
    </ui:VisualElement>
</ui:UXML>
