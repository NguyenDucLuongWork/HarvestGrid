.farm-panel-container {
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
}

.farm-grid {
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: 36px;
    padding: 16px;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    justify-content: center;
}

.farm-row {
    flex-direction: row;
    gap: 16px;
    align-items: center;
    justify-content: center;
}

/* Soil plot slot - sized for 1080x1920 reference resolution */
.fs {
    width: 172px;
    height: 172px;
    background-color: #724528;
    border-width: 8px;
    border-color: #53321c;
    border-radius: 28px;
    position: relative;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.fs:hover {
    border-color: #e9b11c;
}

.fs-pic {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: -8px;
}

.plant-icon-single {
    font-size: 82px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.plant-two-wrap {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 100%;
}

.plant-icon-half {
    font-size: 62px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.plant-image {
    width: 76%;
    height: 76%;
    -unity-background-scale-mode: scale-to-fit;
}

/* Requirement bottom badge: inline 💧 0/2 */
.fs-req {
    position: absolute;
    bottom: 8px;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.fs-res-icon {
    font-size: 32px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.fs-req-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
    margin: 0;
    padding: 0;
}
