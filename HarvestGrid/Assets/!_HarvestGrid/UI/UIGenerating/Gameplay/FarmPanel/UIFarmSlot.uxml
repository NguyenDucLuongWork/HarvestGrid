<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="fs-root" class="fs">
        <!-- Plant Pic Container -->
        <ui:VisualElement name="fs-pic" class="fs-pic">
            <!-- Single plant display (sprout 🌱, sunflower 🌻) -->
            <ui:Label name="lbl-single-plant" text="🌱" class="plant-icon-single" />

            <!-- Two plants side by side (e.g. 🌽🌽, 🥒🥒) -->
            <ui:VisualElement name="fs-two-plants" class="plant-two-wrap" style="display: none;">
                <ui:Label name="lbl-two-1" text="🌽" class="plant-icon-half" />
                <ui:Label name="lbl-two-2" text="🌽" class="plant-icon-half" />
            </ui:VisualElement>

            <!-- Custom Sprite Texture/Image if provided -->
            <ui:VisualElement name="img-plant-icon" class="plant-image" style="display: none;" />
        </ui:VisualElement>

        <!-- Requirement Text at Bottom: Drop Icon + 0/2 -->
        <ui:VisualElement name="fs-req-wrap" class="fs-req">
            <ui:Label name="lbl-res-icon" text="💧" class="fs-res-icon" />
            <ui:Label name="lbl-req-text" text="0/2" class="fs-req-text" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
