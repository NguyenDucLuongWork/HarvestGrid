/* =========================================================================
   FarmPanel.uss — 5×5 visual farm grid  (Farm Game UI.html design language)
   ========================================================================= */

/* ── Shell ───────────────────────────────────────────────────────────────── */
.panel {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 230px;
    bottom: 360px;
    background-color: #fff3d1;
    border-width: 10px;
    border-color: #7a4a24;
    border-radius: 50px;
    flex-direction: column;
    overflow: hidden;
}

/* ── Header ──────────────────────────────────────────────────────────────── */
.ph {
    height: 150px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: #c98a4b;
    border-bottom-width: 8px;
    border-bottom-color: #7a4a24;
}

.ph-title {
    color: #ffffff;
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── Body ────────────────────────────────────────────────────────────────── */
.pb {
    flex-grow: 1;
    flex-direction: column;
    padding: 24px 32px 20px;
    overflow: hidden;
}

/* ── Stats chips ─────────────────────────────────────────────────────────── */
.stats-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 20px;
    gap: 14px;
}

.stat-chip {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    background-color: #f1dba6;
    border-width: 5px;
    border-color: #d3b36a;
    border-radius: 24px;
    padding: 12px 8px;
}

.stat-label {
    font-size: 30px;
    color: #8a6a40;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.stat-value {
    font-size: 50px;
    color: #3b2410;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── ScrollView wrapper ──────────────────────────────────────────────────── */
.farm-scroll {
    flex-grow: 1;
    /* hide scrollbars — touch-drag / mouse-wheel still works */
    --vertical-scrollbar-width: 0;
    --horizontal-scrollbar-height: 0;
}

/* Unity ScrollView injects a content container; let it stretch */
.farm-scroll > #unity-content-container {
    flex-direction: column;
}

/* ── 5×5 Farm Grid ───────────────────────────────────────────────────────── */
/*
   flex-wrap: wrap + 20%-wide cells → 5 per row automatically.
   Gaps are built into the cell padding (4 px each side = 8 px between cells).
*/
.farm-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* ── Farm slot cell ──────────────────────────────────────────────────────── */
.farm-slot {
    width: 20%;
    aspect-ratio: 1;      /* square tile  (Unity 6+ supports this property) */
    padding: 4px;
    position: relative;   /* needed so absolute children fill it correctly  */
    overflow: hidden;
    border-radius: 16px;
    cursor: link;
    transition-duration: 0.08s;
    transition-property: scale;
}

.farm-slot:hover  { scale: 1.07; }
.farm-slot:active { scale: 0.94; }

/* ── State modifiers ─────────────────────────────────────────────────────── */
.farm-slot.slot-empty {
    opacity: 0.60;
}

.farm-slot.slot-locked {
    opacity: 0.35;
}

/* Gold glow border → ready to harvest */
.farm-slot.slot-harvestable {
    border-width: 4px;
    border-color: #ffc61a;
}

/* Green border → growing */
.farm-slot.slot-growing {
    border-width: 4px;
    border-color: #7bc043;
}

/* ── Template root (FarmSlotItem.uxml root VisualElement, class="slot-cell") */
.slot-cell {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
}

/* ── Soil background Image (set by FarmPanel.cs: scaleMode = StretchToFill) */
.slot-img {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 12px;
}

/* ── Plant overlay Image (set by FarmPanel.cs: scaleMode = ScaleToFit) ────── */
.plant-img {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ── Harvest-all button ──────────────────────────────────────────────────── */
.btn {
    height: 90px;
    border-radius: 24px;
    border-width: 6px;
    border-color: #4d8a20;
    background-color: #7bc043;
    color: #ffffff;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.btn-harvest {
    margin-top: 16px;
}

.btn:hover  { opacity: 0.9; }
.btn:active { translate: 0 5px; }

.btn:disabled,
.unity-disabled {
    background-color: #bbbbbb;
    border-color: #888888;
    color: #eeeeee;
}
