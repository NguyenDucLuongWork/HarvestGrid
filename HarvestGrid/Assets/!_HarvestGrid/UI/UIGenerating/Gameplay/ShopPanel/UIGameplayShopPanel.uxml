<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="UIGameplayShopPanel.uss" />
    <ui:VisualElement name="shop-panel-root" class="shop-panel-container">
        <!-- 3 Offers Row / Grid -->
        <ui:VisualElement name="offers-container" class="offers-grid">
            <!-- Dynamically populated from UIShopOfferItem.uxml -->
        </ui:VisualElement>

        <!-- Reroll Shop Button -->
        <ui:Button name="btn-reroll" class="reroll-btn">
            <ui:Label name="lbl-reroll" text="Reroll shop 💎 10" class="reroll-btn-text" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
