.shop-panel-container {
    width: 100%;
    align-items: center;
    padding: 10px 16px;
    gap: 16px;
}

.offers-grid {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    gap: 16px;
    width: 100%;
    max-width: 1000px;
    background-color: #6c8f3b;
    border-width: 8px;
    border-color: #c98a3b;
    border-radius: 36px;
    padding: 16px;
}

/* Single Offer Card */
.offer-card {
    flex-grow: 1;
    flex-basis: 0;
    background-color: #d7c8f5;
    border-width: 5px;
    border-color: #9a86d6;
    border-radius: 26px;
    padding: 12px;
    align-items: center;
    gap: 8px;
    overflow: hidden;
}

.offer-card.sold {
    opacity: 0.5;
}

.offer-card.held {
    border-color: #ffffff;
    border-width: 5px;
}

.offer-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #4a2f17;
    -unity-text-align: middle-center;
    height: 52px;
    width: 100%;
    white-space: normal;
}

/* Footprint Preview inside Offer */
.offer-preview {
    width: 100%;
    height: 130px;
    background-color: rgba(255, 255, 255, 0.45);
    border-radius: 16px;
    position: relative;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.fp-preview-grid {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
}

.fp-preview-row {
    flex-direction: row;
    gap: 5px;
}

.fp-preview-cell {
    width: 36px;
    height: 36px;
    border-radius: 6px;
}

.fp-preview-cell.on {
    background-color: #e9b11c;
    border-width: 3px;
    border-color: #b98400;
}

.fp-preview-cell.off {
    background-color: transparent;
}

.offer-icon-wrap {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.offer-icon-text {
    font-size: 64px;
    -unity-text-align: middle-center;
}

.offer-icon-image {
    width: 80%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.offer-info {
    font-size: 26px;
    -unity-font-style: bold;
    color: #4a2f17;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.offer-buy-btn {
    width: 100%;
    height: 60px;
    border-radius: 20px;
    border-width: 0;
    background-color: #5cc13a;
    color: #ffffff;
    font-size: 28px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.offer-buy-btn:active {
    background-color: #46962b;
}

/* Reroll Button */
.reroll-btn {
    align-self: center;
    border-radius: 26px;
    border-width: 0;
    background-color: #3aa7e8;
    padding: 12px 42px;
    margin-top: -22px;
}

.reroll-btn:active {
    background-color: #2b84ba;
}

.reroll-btn-text {
    color: #ffffff;
    font-size: 32px;
    -unity-font-style: bold;
}
